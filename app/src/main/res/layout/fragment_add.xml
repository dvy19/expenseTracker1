<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#101922">

    <LinearLayout
        android:layout_marginTop="10dp"
        android:id="@+id/heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:gravity="center_vertical"
        >

        <ImageView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:src="@drawable/arrow"
            app:tint="#f6f7f8"
            android:rotation="-90"
            android:layout_weight="1"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textAlignment="center"
            android:fontFamily="@font/poppins_semibold"
            android:text="Add Expense"
            android:textColor="#f6f7f8"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="Save"
            android:textColor="#137fec"
            android:textSize="16sp"
            android:paddingEnd="10dp"
            android:paddingStart="10dp"
            android:textAlignment="viewEnd"
            android:textStyle="bold" />
    </LinearLayout>


    <LinearLayout
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amount"
            android:textColor="#89f6f7f8"
            android:textSize="18dp"
            />

        <EditText
            android:textColor="@color/black"
            android:id="@+id/expense"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/inputs"
            android:hint="0.00"
            android:paddingStart="15dp"
            android:paddingEnd="14dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            />




        <TextView
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textColor="#89f6f7f8"
            android:textSize="18dp"
            />

        <EditText
            android:layout_marginTop="8dp"
            android:textColor="#f6f7f8"
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/inputs"
            android:hint="Today"
            android:inputType="date"
            android:focusable="false"
            android:clickable="true"
            android:textColorHint="#f6f7f8"
            android:paddingStart="15dp"
            android:paddingEnd="14dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"

            />

        <TextView
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Note"
            android:textColor="#89f6f7f8"
            android:textSize="18dp"
            />

        <EditText
            android:textColor="@color/black"
            android:id="@+id/note"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/inputs"
            android:hint="What is this for?"
            android:paddingStart="15dp"
            android:paddingEnd="14dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            />


        <TextView
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textColor="#89f6f7f8"
            android:textSize="18dp"
            />

        <Spinner
            android:layout_marginTop="8dp"
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/inputs"
            android:padding="12dp" />





        <Button
            android:padding="12dp"
            android:id="@+id/saveExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#137fec"
            android:text="Save Expense"
            android:textColor="@color/blue_white"
            android:textSize="18sp"
            android:layout_marginTop="150dp"

            />



    </LinearLayout>

</LinearLayout>